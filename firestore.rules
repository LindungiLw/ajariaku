rules_version = '2';

// Aturan keamanan Firestore Ajari Aku.
// Deploy: firebase deploy --only firestore:rules
// PENTING: jangan biarkan database dalam "test mode" (allow if true) — itu membuka
// seluruh data pengguna (termasuk email) ke publik.
service cloud.firestore {
  match /databases/{database}/documents {

    // Setiap pengguna hanya boleh membaca/menulis dokumennya SENDIRI.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Tulis hanya dokumen sendiri + hanya field yang dikenal aplikasi (cegah injeksi field arbitrer).
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['pengajar', 'progress', 'sesi', 'murid', 'memori', 'tema', 'updatedAt']
           );
    }

    // Papan peringkat global OPSIONAL & anonim — HANYA {nick, xp, updatedAt} (tanpa PII).
    // Baca publik (papan memang untuk dilihat); tulis/hapus hanya dokumen sendiri + tervalidasi.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'xp', 'updatedAt'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 1
        && request.resource.data.nick.size() <= 24
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 1000000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Default: tolak semua akses ke path lain.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
